# CropAI Environment Configuration
# Copy this file to .env and fill in your API keys

# ─────────────────────────────────────────────
# REQUIRED: OpenRouter API Key
# Get your key at: https://openrouter.ai/keys
# ─────────────────────────────────────────────
OPENROUTER_API_KEY=your_openrouter_api_key_here

# Vision model to use via OpenRouter (must support image input)
# Recommended options:
#   google/gemini-2.0-flash-exp:free
#   anthropic/claude-3.5-sonnet
#   openai/gpt-4o
#   google/gemini-pro-vision
VISION_MODEL=google/gemini-2.0-flash-exp:free

# ─────────────────────────────────────────────
# OPTIONAL: Segmentation API (for pixel-level extraction)
# When not configured, the app falls back to smart bounding-box crops.
# Supported providers: "replicate" | "huggingface" | "none"
# ─────────────────────────────────────────────
SEGMENTATION_PROVIDER=none

# Replicate API Token (if SEGMENTATION_PROVIDER=replicate)
# Get your token at: https://replicate.com/account/api-tokens
REPLICATE_API_TOKEN=

# HuggingFace API Token (if SEGMENTATION_PROVIDER=huggingface)
HUGGINGFACE_API_TOKEN=

# ─────────────────────────────────────────────
# Server Configuration
# ─────────────────────────────────────────────
PORT=3000
NODE_ENV=development

# Maximum upload file size in bytes (default: 10MB)
MAX_FILE_SIZE=10485760

# How long (ms) to keep temporary files before auto-cleanup (default: 1 hour)
FILE_TTL_MS=3600000
